{
  "name": "cloudflare-uptime-monitor",
  "private": true,
  "license": "MIT",
  "description": "A self-hosted uptime monitor for Cloudflare Workers, D1 and Cloudflare Access.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/setup.mjs",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "node scripts/setup.mjs && wrangler types --strict-vars=false -c wrangler.example.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "packageManager": "pnpm@10.32.1"
}
